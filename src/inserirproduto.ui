QGroupBox { background-color: white; border: 1px solid #d5dee9; border-radius: 10px; margin-top: 16px; padding: 16px 14px 12px 14px; font-weight: 700; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #142D45; background-color: #F2F7F4; }
