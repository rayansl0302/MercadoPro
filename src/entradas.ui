  <property name="styleSheet">
   <string notr="true">
#Entradas {
  background-color: rgb(236, 240, 245);
}
QPushButton {
  background-color: rgb(23, 150, 58);
  color: rgb(255, 255, 255);
  font: 600 10pt &quot;Segoe UI&quot;;
  border-radius: 8px;
  padding: 0 14px;
}
QPushButton:hover {
  background-color: rgb(16, 122, 46);
}
QPushButton:pressed {
  background-color: rgb(143, 217, 163);
}
QPushButton:disabled {
  background-color: rgb(190, 200, 212);
  color: rgb(245, 247, 250);
}
QPushButton#Btn_Devolucao {
  background-color: rgb(191, 61, 64);
}
QPushButton#Btn_Devolucao:hover {
  background-color: rgb(160, 40, 44);
}
QPushButton#Btn_Devolucao:disabled {
  background-color: rgb(190, 200, 212);
}
QPushButton#Btn_VerDanfe, QPushButton#Btn_ConsultarDF {
  background-color: rgb(71, 85, 105);
}
QPushButton#Btn_VerDanfe:hover, QPushButton#Btn_ConsultarDF:hover {
  background-color: rgb(51, 65, 85);
}
QPushButton#Btn_VerDanfe:disabled {
  background-color: rgb(190, 200, 212);
}
QFrame#frame_Filtros, QFrame#frame_Chave, QFrame#frame_Notas, QFrame#frame_Itens {
  background-color: white;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
}
QFrame#frame_Filtros QLabel, QFrame#frame_Chave QLabel, QFrame#frame_Notas QLabel, QFrame#frame_Itens QLabel {
  background-color: transparent;
  border: none;
  color: rgb(51, 65, 85);
  font: 10pt &quot;Segoe UI&quot;;
}
QLabel#Lbl_TituloFiltros, QLabel#Lbl_Chave, QLabel#label, QLabel#label_2 {
  font: 700 11pt &quot;Ubuntu&quot;;
  color: rgb(30, 41, 59);
}
QLabel#Lbl_ResumoItens, QLabel#Lbl_QtdNotas {
  color: rgb(100, 116, 139);
  font: 600 10pt &quot;Segoe UI&quot;;
}
QLineEdit, QDateEdit {
  background-color: white;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 0 10px;
  font: 11pt &quot;Segoe UI&quot;;
  color: rgb(30, 41, 59);
}
QLineEdit:focus, QDateEdit:focus {
  border: 2px solid rgb(23, 150, 58);
}
QTableView {
  background-color: #ffffff;
  alternate-background-color: #f1f5f9;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  gridline-color: #e2e8f0;
  selection-background-color: rgb(23, 150, 58);
  selection-color: #ffffff;
  font: 10pt &quot;Segoe UI&quot;;
  outline: none;
}
QTableView::item {
  padding: 4px 6px;
}
QHeaderView::section {
  background-color: #f1f5f9;
  color: #475569;
  font: 700 9pt &quot;Ubuntu&quot;;
  border: none;
  border-bottom: 2px solid #e2e8f0;
  border-right: 1px solid #e2e8f0;
  padding: 8px 10px;
}
QHeaderView::section:last {
  border-right: none;
}
QScrollBar:vertical {
  background: #f1f5f9;
  width: 8px;
  border-radius: 4px;
}
QScrollBar::handle:vertical {
  background: #cbd5e1;
  border-radius: 4px;
  min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}
   </string>
